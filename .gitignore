# Python
.venv/
__pycache__/
*.pyc

# Sekrety lokalne (kurs nie ma LLM, ale .env może zawierać lokalne nadpisania)
.env

# Wygenerowany korpus danych (duży, deterministyczny — odtwarzalny przez
# scripts/gen_corpus.py, nie commitować)
data/corpus/
data/origin_images/*
!data/origin_images/.gitkeep

# Artefakty profilowania generowane w trakcie ćwiczeń (py-spy/cProfile/memray/
# notatki ex06/ex10/ex15/ex16) — konwencja nazw: profiles/exNN_*.{svg,html,prof,txt,md}
*.memray
*.bin
.pyroscope/
profiles/*
!profiles/.gitkeep

# Katalog na tymczasowe profile/artefakty py-spy/memray wygenerowane w trakcie
# ćwiczeń (NIE ignorujemy solutions/*.svg ani solutions/*.html — to celowe
# artefakty referencyjne, więc nie stosujemy globalnego wzorca *.svg/*.html)
/tmp_profiles/

# rusztowanie procesu budowy (nie treść kursu)
.kurs-build-state.md
.kurs-build/

# Obrazy wgrywane w trakcie działania aplikacji / loadgenu (czyść: python scripts/reset_uploads.py)
data/uploads/
