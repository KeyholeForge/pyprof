# Kurs pyprof nie używa LLM — ZERO kluczy API, zero sekretów.
# Wszystkie zmienne poniżej są lokalne/deterministyczne, bezpieczne do commitowania
# jako .env.example. Skopiuj do .env i dostosuj w razie potrzeby:
#   cp .env.example .env

# Port aplikacji pixelforge (uruchamianej lokalnie, NIE w Dockerze)
PIXELFORGE_PORT=8040

# Adres serwera Pyroscope (Docker, port hosta 4040)
PYROSCOPE_SERVER_ADDRESS=http://127.0.0.1:4040
PYROSCOPE_APPLICATION_NAME=pixelforge
# Tryb profilera wybierany przy starcie procesu: 0 = CPU, 1 = wall-clock
PYROSCOPE_WALL=0

# Adres serwisu origin (Docker, statyczne obrazy do pobierania przez aplikację)
ORIGIN_BASE_URL=http://127.0.0.1:8041

# Ścieżki do lokalnego korpusu danych (generowane przez scripts/gen_corpus.py,
# NIE commitowane — patrz .gitignore)
CORPUS_DIR=data/corpus
ORIGIN_IMAGES_DIR=data/origin_images
