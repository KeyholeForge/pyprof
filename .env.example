# The pyprof course does not use an LLM — ZERO API keys, zero secrets.
# All the variables below are local/deterministic, safe to commit
# as .env.example. Copy it to .env and adjust if needed:
#   cp .env.example .env

# The port of the pixelforge application (run locally, NOT in Docker)
PIXELFORGE_PORT=8040

# The Pyroscope server address (Docker, host port 4040)
PYROSCOPE_SERVER_ADDRESS=http://127.0.0.1:4040
PYROSCOPE_APPLICATION_NAME=pixelforge
# The profiler mode, chosen at process start: 0 = CPU, 1 = wall-clock
PYROSCOPE_WALL=0

# The address of the origin service (Docker, static images for the application to download)
ORIGIN_BASE_URL=http://127.0.0.1:8041

# Paths to the local data corpus (generated by scripts/gen_corpus.py,
# NOT committed — see .gitignore)
CORPUS_DIR=data/corpus
ORIGIN_IMAGES_DIR=data/origin_images
